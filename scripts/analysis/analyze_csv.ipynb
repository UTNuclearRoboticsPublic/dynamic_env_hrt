 "cells": [
  {
   "cell_type": "raw",
   "id": "a26dda68-ac8d-4a60-bac8-fa7b1ff4997c",
   "metadata": {},
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Trial Analysis: Phase 1 - Event Timeline Generation\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook parses the raw event CSV generated by `bag_to_event_csv.py` to identify the precise start, end, and intermediate marked events for each trial. The output is a structured YAML file containing this timeline, which serves as the input for subsequent analysis phases.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Imports, Configuration, and Helper Functions\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import yaml\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Variables to Configure ---\\n\",\n",
    "    \"cohort_number = 1\\n\",\n",
    "    \"input_csv_file = Path(f'path/to/your/input_events_cohort_{cohort_number}.csv')\\n\",\n",
    "    \"output_event_timeline_file = Path(f'cohort_{cohort_number}_event_timeline.yaml')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Constants ---\\n\",\n",
    "    \"# Time threshold to group button press events. If the time between two 'True' \\n\",\n",
    "    \"# events is greater than this, they are considered separate logical events.\\n\",\n",
    "    \"EVENT_GROUPING_THRESHOLD_NS = 75_000_000  # 75 milliseconds\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- Helper Functions ---\\n\",\n",
    "    \"def robust_csv_value_to_bool(value) -> bool:\\n\",\n",
    "    \"    \\\"\\\"\\\"Converts a value read from a CSV cell to a boolean robustly.\\\"\\\"\\\"\\n\",\n",
    "    \"    if pd.isna(value):\\n\",\n",
    "    \"        return False\\n\",\n",
    "    \"    if isinstance(value, bool):\\n\",\n",
    "    \"        return value\\n\",\n",
    "    \"    if isinstance(value, (int, float)):\\n\",\n",
    "    \"        return bool(value)\\n\",\n",
    "    \"    return str(value).strip().lower() == 'true'\\n\",\n",
    "    \"\\n\",\n",
    "    \"def process_and_finalize_event_group(group_ts_list: list) -> int:\\n\",\n",
    "    \"    \\\"\\\"\\\"Calculates the average timestamp of an event group.\\\"\\\"\\\"\\n\",\n",
    "    \"    if not group_ts_list:\\n\",\n",
    "    \"        return 0\\n\",\n",
    "    \"    # Calculate the average time of the event group from its first and last timestamp\\n\",\n",
    "    \"    return (group_ts_list[0] + group_ts_list[-1]) // 2\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. First Pass: Find Trial Boundaries and Marked Events\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load and prepare the DataFrame\\n\",\n",
    "    \"try:\\n\",\n",
    "    \"    df = pd.read_csv(input_csv_file, keep_default_na=True, na_values=[''])\\n\",\n",
    "    \"    print(f\\\"Successfully loaded {input_csv_file}\\\")\\n\",\n",
    "    \"except FileNotFoundError:\\n\",\n",
    "    \"    print(f\\\"Error: Input CSV file not found at '{input_csv_file}'\\\")\\n\",\n",
    "    \"    df = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"if df is not None:\\n\",\n",
    "    \"    # Ensure required columns are present and converted to boolean\\n\",\n",
    "    \"    required_events = ['researcher-trial-start', 'researcher-trial-end', 'researcher-mark-event']\\n\",\n",
    "    \"    for col in required_events:\\n\",\n",
    "    \"        if col not in df.columns:\\n\",\n",
    "    \"            raise ValueError(f\\\"Error: Required column '{col}' not found in the input CSV.\\\")\\n\",\n",
    "    \"        df[col] = df[col].apply(robust_csv_value_to_bool)\\n\",\n",
    "    \"        \\n\",\n",
    "    \"    # --- State Machine Initialization ---\\n\",\n",
    "    \"    event_timeline = {}\\n\",\n",
    "    \"    current_trial_number = 1\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # State variables for trial start/end\\n\",\n",
    "    \"    active_trial_start_ts = None\\n\",\n",
    "    \"    last_start_signal_ts = None\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # State variables for marked events within a trial\\n\",\n",
    "    \"    active_trial_marked_events = []\\n\",\n",
    "    \"    current_marked_event_group_ts = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(\\\"Parsing CSV to build event timeline...\\\")\\n\",\n",
    "    \"    # --- Main Loop ---\\n\",\n",
    "    \"    for index, row in df.iterrows():\\n\",\n",
    "    \"        timestamp_ns = row['timestamp']\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # --- Trial Start Logic (on button release) ---\\n\",\n",
    "    \"        if row['researcher-trial-start']:\\n\",\n",
    "    \"            if active_trial_start_ts is not None:\\n\",\n",
    "    \"                print(f\\\"Warning (row {index + 2}): New 'start' signal while trial {current_trial_number} was active. Aborting previous trial.\\\")\\n\",\n",
    "    \"            last_start_signal_ts = timestamp_ns\\n\",\n",
    "    \"            active_trial_start_ts = None # Reset active trial until release\\n\",\n",
    "    \"\\n\",\n",
    "    \"        elif last_start_signal_ts is not None and active_trial_start_ts is None:\\n\",\n",
    "    \"            # Start button was just released, a trial is now officially active\\n\",\n",
    "    \"            active_trial_start_ts = last_start_signal_ts\\n\",\n",
    "    \"            print(f\\\"TRIAL {current_trial_number} START detected at timestamp: {active_trial_start_ts}\\\")\\n\",\n",
    "    \"            # Reset accumulators for the new trial\\n\",\n",
    "    \"            active_trial_marked_events = []\\n\",\n",
    "    \"            current_marked_event_group_ts = []\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # --- Logic that runs only during an active trial ---\\n\",\n",
    "    \"        if active_trial_start_ts is not None:\\n\",\n",
    "    \"            # --- Marked Event Logic (time-based grouping) ---\\n\",\n",
    "    \"            if row['researcher-mark-event']:\\n\",\n",
    "    \"                if current_marked_event_group_ts and (timestamp_ns - current_marked_event_group_ts[-1]) > EVENT_GROUPING_THRESHOLD_NS:\\n\",\n",
    "    \"                    # Gap is too large, finalize old group and start a new one\\n\",\n",
    "    \"                    final_event_ts = process_and_finalize_event_group(current_marked_event_group_ts)\\n\",\n",
    "    \"                    active_trial_marked_events.append(final_event_ts)\\n\",\n",
    "    \"                    print(f\\\"  - Marked event for trial {current_trial_number} recorded at avg time {final_event_ts}\\\")\\n\",\n",
    "    \"                    current_marked_event_group_ts = [timestamp_ns]\\n\",\n",
    "    \"                else:\\n\",\n",
    "    \"                    # Continue the current group\\n\",\n",
    "    \"                    current_marked_event_group_ts.append(timestamp_ns)\\n\",\n",
    "    \"            \\n\",\n",
    "    \"            # --- Trial End Logic (on first button press) ---\\n\",\n",
    "    \"            if row['researcher-trial-end']:\\n\",\n",
    "    \"                trial_end_ts = timestamp_ns\\n\",\n",
    "    \"                print(f\\\"TRIAL {current_trial_number} END detected at timestamp: {trial_end_ts}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"                # Finalize any pending marked event group\\n\",\n",
    "    \"                if current_marked_event_group_ts:\\n\",\n",
    "    \"                    final_event_ts = process_and_finalize_event_group(current_marked_event_group_ts)\\n\",\n",
    "    \"                    active_trial_marked_events.append(final_event_ts)\\n\",\n",
    "    \"                    print(f\\\"  - Marked event (held at trial end) for trial {current_trial_number} recorded at avg time {final_event_ts}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"                # --- Assemble the trial data dictionary ---\\n\",\n",
    "    \"                trial_data = {\\n\",\n",
    "    \"                    'trial-start': {\\n\",\n",
    "    \"                        'timestamp': active_trial_start_ts,\\n\",\n",
    "    \"                        'trial-rel-time': 0.0\\n\",\n",
    "    \"                    }\\n\",\n",
    "    \"                }\\n\",\n",
    "    \"                \\n\",\n",
    "    \"                # Add marked events in the order they appeared\\n\",\n",
    "    \"                for i, event_ts in enumerate(sorted(active_trial_marked_events)):\\n\",\n",
    "    \"                    rel_time = (event_ts - active_trial_start_ts) / 1e9\\n\",\n",
    "    \"                    trial_data[f'event-{i+1}'] = {\\n\",\n",
    "    \"                        'timestamp': event_ts,\\n\",\n",
    "    \"                        'trial-rel-time': round(rel_time, 4)\\n\",\n",
    "    \"                    }\\n\",\n",
    "    \"                \\n\",\n",
    "    \"                # Add trial end\\n\",\n",
    "    \"                rel_time = (trial_end_ts - active_trial_start_ts) / 1e9\\n\",\n",
    "    \"                trial_data['trial-end'] = {\\n\",\n",
    "    \"                    'timestamp': trial_end_ts,\\n\",\n",
    "    \"                    'trial-rel-time': round(rel_time, 4)\\n\",\n",
    "    \"                }\\n\",\n",
    "    \"                \\n\",\n",
    "    \"                event_timeline[str(current_trial_number)] = trial_data\\n\",\n",
    "    \"                \\n\",\n",
    "    \"                # Reset state for the next trial\\n\",\n",
    "    \"                current_trial_number += 1\\n\",\n",
    "    \"                active_trial_start_ts = None\\n\",\n",
    "    \"                last_start_signal_ts = None\\n\",\n",
    "    \"                active_trial_marked_events = []\\n\",\n",
    "    \"                current_marked_event_group_ts = []\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    print(\\\"\\\\nParsing complete.\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Save and Inspect Event Timeline\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"if event_timeline:\\n\",\n",
    "    \"    # Save the timeline to a YAML file for the next phase of analysis\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        with open(output_event_timeline_file, 'w') as f:\\n\",\n",
    "    \"            yaml.dump(event_timeline, f, indent=2, default_flow_style=False, sort_keys=False)\\n\",\n",
    "    \"        print(f\\\"Event timeline successfully saved to: {output_event_timeline_file}\\\")\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(f\\\"Error saving YAML file: {e}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Display the final dictionary for inspection\\n\",\n",
    "    \"    # For a cleaner look, you can also use `import json; print(json.dumps(event_timeline, indent=2))`\\n\",\n",
    "    \"    print(\\\"\\\\n--- Generated Event Timeline ---\\\")\\n\",\n",
    "    \"    # event_timeline\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"No complete trials were found. No timeline generated.\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
